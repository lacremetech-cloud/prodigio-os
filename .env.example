# Prodigio OS — variables d'environnement (exemple)
#
# Ce fichier documente les variables attendues. Il ne contient AUCUN secret et
# ne doit jamais en contenir. Copiez-le en `.env.local` pour un usage local ;
# les fichiers `.env` réels sont ignorés par Git.
#
# L'application démarre SANS aucune de ces variables. Tant que Supabase n'est pas
# configuré, la landing et l'analyse d'éligibilité fonctionnent, mais le dépôt
# d'une demande est désactivé proprement (message clair, aucune donnée perdue).

# NODE_ENV est fourni automatiquement par Next.js / Node (development, test,
# production). Ne pas le définir manuellement en général.
# NODE_ENV=development

# -----------------------------------------------------------------------------
# Supabase — dépôt public d'une demande (funnel Mandats).
#
# On n'utilise QUE la clé PUBLIABLE (anon), sûre côté navigateur. Le dépôt passe
# par une fonction SQL contrôlée (SECURITY DEFINER) : le public peut déposer une
# demande mais ne peut JAMAIS lire, modifier ni supprimer les données (RLS).
#
# Ne JAMAIS ajouter ici : clé service_role, mot de passe Supabase,
# SUPABASE_DB_URL, ni aucune chaîne de connexion PostgreSQL. Ces secrets n'ont
# pas leur place dans le dépôt ni dans ce funnel.
# -----------------------------------------------------------------------------

# URL du projet Supabase (publique). Ex. https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Clé PUBLIABLE (anon) du projet Supabase. Publique par conception, protégée par
# les politiques RLS. NE PAS utiliser la clé service_role.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Référence du projet Supabase (identifiant public, ex. « abcdefghijklmnop »).
# Sert la documentation et l'application des migrations ; non secret.
SUPABASE_PROJECT_REF=

# Clé SECRÈTE Supabase (moderne « sb_secret_… », depuis Supabase → Settings →
# API Keys). Utilisée EXCLUSIVEMENT côté serveur pour les invitations Auth
# (inviteUserByEmail) de la gestion des utilisateurs. STRICTEMENT serveur :
#   - JAMAIS de préfixe NEXT_PUBLIC_ ; JAMAIS renvoyée au client ; JAMAIS journalisée.
# Sans elle, l'espace « Équipe & accès » reste consultable mais l'envoi réel
# d'invitations est désactivé (erreur de configuration réservée aux administrateurs).
# ⚠️ Ne JAMAIS committer de vraie clé : uniquement un placeholder vide.
SUPABASE_SECRET_KEY=

# -----------------------------------------------------------------------------
# Landing propriétaire — options publiques (aucun secret).
# -----------------------------------------------------------------------------

# URL canonique publique du site (métadonnées / SEO). Optionnelle.
# NEXT_PUBLIC_SITE_URL=https://prodigio.example

# URL de la présentation vidéo (VSL) — Vimeo ou Wistia (URL d'intégration).
# Tant qu'elle est vide, la landing affiche un visuel éditorial premium, sans
# faux lecteur ni faux bouton de lecture. Permet de brancher la VSL sans
# reconstruire la page.
# NEXT_PUBLIC_MANDATE_VSL_URL=

# -----------------------------------------------------------------------------
# Cloudflare Turnstile — anti-abus du dépôt public de demande (funnel Mandats).
#
# Le dépôt Supabase n'a lieu QUE si le jeton Turnstile est vérifié côté serveur
# (siteverify). Le navigateur ne transmet QUE le jeton ; le secret reste
# STRICTEMENT côté serveur (jamais préfixé NEXT_PUBLIC_, jamais renvoyé au
# client, jamais journalisé). Action attendue : « mandate_submission ».
#
# ⚠️ Ne JAMAIS committer de vraies clés ici : uniquement des placeholders.
# En PRODUCTION, l'application REFUSE les clés de TEST Cloudflare (voir plus bas).
# -----------------------------------------------------------------------------

# Clé de SITE (publique, rendue par le navigateur). Sans elle, le widget n'est
# pas affiché.  Dev / tests : clé de test « succès » 1x00000000000000000000AA.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# SECRET serveur (jamais exposé). Dev / tests : secrets de test officiels —
#   succès       : 1x0000000000000000000000000000000AA
#   échec         : 2x0000000000000000000000000000000AA
#   déjà utilisé  : 3x0000000000000000000000000000000AA
# Ces clés de test sont REFUSÉES en production (garde-fou serveur).
TURNSTILE_SECRET_KEY=

# Hostname attendu dans la réponse de siteverify (contrôle d'origine). Imposé
# EN PRODUCTION lorsqu'il est défini ; facultatif hors production (les clés de
# test renvoient un hostname arbitraire). Ex. « prodigio.fr ».
TURNSTILE_EXPECTED_HOSTNAME=

# -----------------------------------------------------------------------------
# VSL de la landing propriétaire (vidéo de présentation).
#
# L'identifiant de la vidéo est centralisé dans src/config/vsl.ts (valeur par
# défaut : la vidéo provisoire). Pour la remplacer par la VSL définitive sans
# toucher au code, définir cette variable avec l'ID YouTube (11 caractères).
# Intégration « nocookie », lecture auto silencieuse, sans habillage YouTube.
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_VSL_YOUTUBE_ID=rgH1uqNdvHs

# -----------------------------------------------------------------------------
# Slack — alerte opérationnelle « Nouvelle demande de mandat ».
#
# URL de webhook entrant Slack (https://hooks.slack.com/services/…), pointant
# vers le canal PRIVÉ des alertes Mandats. STRICTEMENT côté serveur :
#   - JAMAIS préfixée NEXT_PUBLIC_ (jamais incluse dans le bundle navigateur) ;
#   - JAMAIS renvoyée au client, JAMAIS journalisée.
#
# Présente en PRODUCTION uniquement (ajoutée dans Vercel). En preview / dev, la
# laisser VIDE : les notifications sont alors désactivées proprement (le funnel
# fonctionne normalement, aucun appel Slack, aucune erreur).
#
# ⚠️ Ne JAMAIS committer de vraie URL de webhook ici : uniquement un placeholder.
# -----------------------------------------------------------------------------
SLACK_MANDATES_WEBHOOK_URL=

# -----------------------------------------------------------------------------
# Google Calendar — planification des rendez-vous d'estimation.
#
# Chaque utilisateur concerné (administrateur, manager, agent immobilier)
# connecte SON propre compte Google via OAuth officiel depuis
# /crm/parametres/calendrier. Les jetons Google (access + refresh) restent
# STRICTEMENT côté serveur et sont CHIFFRÉS au repos (AES-256-GCM). Aucun jeton,
# aucun secret OAuth n'apparaît côté navigateur, dans les logs, dans Git, dans
# les réponses publiques ni dans les audit_events.
#
# ⚠️ Ne JAMAIS committer de vraies valeurs ici : uniquement des placeholders.
# ⚠️ Ne JAMAIS préfixer ces variables NEXT_PUBLIC_ (elles seraient exposées au
#    navigateur). Ce sont des variables serveur Vercel.
#
# Création du projet, API et scopes à activer, Redirect URLs : voir
# docs/13-CALENDAR-ESTIMATIONS.md.
# -----------------------------------------------------------------------------

# Identifiant client OAuth (Google Cloud → API et services → Identifiants).
GOOGLE_OAUTH_CLIENT_ID=

# Secret client OAuth (STRICTEMENT serveur, jamais exposé, jamais journalisé).
GOOGLE_OAUTH_CLIENT_SECRET=

# URI de redirection OAuth. Optionnelle : dérivée de NEXT_PUBLIC_SITE_URL (ou du
# domaine de production) + /api/calendar/google/callback. À déclarer À
# L'IDENTIQUE dans la console Google Cloud (« Authorized redirect URIs »).
# Ex. https://go.prodigio.fr/api/calendar/google/callback
# GOOGLE_OAUTH_REDIRECT_URI=

# Clé de CHIFFREMENT au repos des jetons Google. 32 octets encodés base64 :
#   openssl rand -base64 32
# STRICTEMENT serveur. Sans elle, la connexion Google Calendar est désactivée
# proprement (jamais de jeton en clair). La rotation de cette clé invalide les
# connexions existantes (les utilisateurs devront se reconnecter).
CALENDAR_TOKEN_ENCRYPTION_KEY=
